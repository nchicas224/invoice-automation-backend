{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }, 
    "logLevel": {
        "default": "Information",
        "Function": "Information",
        "DurableTask": "Warning",
        "DurableOrchestrationActivity": "Warning",
        "DurableOrchestrationWorker": "Warning",
        "DurableOrchestrationController": "Warning"
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[2.*, 3.0.0)"
  },
  "extensions": {
    "durableTask": {
      "hubName": "InvoiceAutomationHub"
    }
  }
}